# --- API access (required for the HTTP server) -------------------------------
# Generate with: kleinanzeigen-mcp gen-token <name>
# Entries: name:token  or  name:sha256:<hex>  (comma separated)
KA_API_TOKENS=
KA_CLIENT_RATE_PER_MIN=60
# KA_ALLOWED_HOSTS=mcp.example.com

# --- politeness towards kleinanzeigen.de (shared by ALL clients/proxies) -----
KA_RATE_PER_S=0.5
KA_BURST=4
KA_MAX_CONCURRENCY=2

# --- cache TTLs in seconds ----------------------------------------------------
KA_TTL_SEARCH=60
KA_TTL_AD=600
KA_TTL_SELLER=3600

# --- optional outbound proxies (http/https/socks5/socks5h, "direct") -----------
# KA_PROXIES=socks5h://user:pass@proxy1:1080,http://user:pass@proxy2:8080
# KA_PROXY_FILE=/app/proxies.txt
# KA_PROXY_INCLUDE_DIRECT=false

# --- browser identity (keep UA and chrome_major in sync) -----------------------
# KA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36
# KA_CHROME_MAJOR=141

# --- robots.txt policy: off | strict (see EVALUATION.md) ----------------------
# KA_ROBOTS_POLICY=off
